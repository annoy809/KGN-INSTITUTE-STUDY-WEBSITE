import { motion } from 'framer-motion';

function AnimatedCard({ title, value }) {
  return (
    <motion.div
      initial={{ opacity: 0, y: 20 }}
      animate={{ opacity: 1, y: 0 }}
      transition={{ duration: 0.5 }}
      className="card"
    >
      <h3>{title}</h3>
      <p>{value}</p>
    </motion.div>
  );
}

export default AnimatedCard;
